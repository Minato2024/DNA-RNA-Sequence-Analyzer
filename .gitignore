# ==========================================
# DNA & RNA Sequence Analyzer - .gitignore
# CSC 442 - Project 2
# ==========================================

# Python cache & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Virtual environments
venv/
.env/
.venv/
env/
ENV/

# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Flask / Python
instance/
.webassets-cache

# Uploaded files (user data - not source code)
static/uploads/*
!static/uploads/.gitkeep

# Environment variables / secrets
.env
.flaskenv
*.pem
*.key

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp